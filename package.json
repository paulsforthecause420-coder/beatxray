{
  "name": "beatxray",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "test": "npm --workspace apps/web run test --if-present",
    "check:env": "bash scripts/check-environment.sh",
    "verify": "bash scripts/verify-repo.sh"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "engines": {
    "node": "22.x"
  }
}
